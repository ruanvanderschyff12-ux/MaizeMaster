<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MaizeMasterTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">#19784C</item>
        <item name="android:windowBackground">#F3F9F4</item>
        <item name="android:statusBarColor">#113D2B</item>
        <item name="android:navigationBarColor">#113D2B</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:buttonStyle">@style/MaizeMasterButton</item>
    </style>
    <style name="MaizeMasterButton" parent="android:style/Widget.Material.Light.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
