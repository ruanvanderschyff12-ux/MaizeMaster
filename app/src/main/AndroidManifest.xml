
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <application
        android:allowBackup="true"
        android:label="MaizeMaster"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity android:name=".FarmerAccountActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".MaizeAiActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".GrowthActivity" android:exported="false" />
        <activity android:name=".HarvestActivity" android:exported="false" />
        <activity android:name=".FieldBoundaryActivity" android:exported="false" />
        <service android:name=".HarvestGpsService" android:exported="false" android:foregroundServiceType="location" />
        <activity android:name=".KnowledgeActivity" android:exported="false" />

        <activity
            android:name=".WeatherActivity"
            android:exported="false" />

        <activity
            android:name=".DashboardActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".MainActivity" android:exported="false" />

    </application>

</manifest>
