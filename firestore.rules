rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /farmers/{farmerId}/fields/{fieldId} {
      allow read, write: if request.auth != null
        && request.auth.uid == farmerId
        && (request.method == 'delete' || (request.resource.data.keys().hasOnly(['payload'])
            && request.resource.data.payload is string
            && request.resource.data.payload.size() < 100000));
    }
  }
}
